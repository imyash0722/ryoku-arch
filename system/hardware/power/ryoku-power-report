#!/usr/bin/env bash
# Ryoku Power Management & Diagnostics Report (TLP + PowerTOP)

set -e

if [[ "$1" == "--live" || "$1" == "-l" ]]; then
    exec sudo powertop
elif [[ "$1" == "--html" || "$1" == "-h" ]]; then
    OUT="${HOME}/powertop-report.html"
    printf "\033[1;36m==>\033[0m Generating PowerTOP HTML report (measuring for 5 seconds)...\n"
    sudo powertop --html="$OUT" --time=5
    printf "\033[1;32m==>\033[0m Report generated at %s\n" "$OUT"
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$OUT"
    fi
    exit 0
fi

BOLD="\033[1m"
RESET="\033[0m"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
DIM="\033[2m"

clear 2>/dev/null || true
echo -e "${BOLD}════════════════════════════════════════════════════════════════════${RESET}"
echo -e "  ${CYAN}RYOKU POWER REPORT${RESET}  ${DIM}·  TLP & PowerTOP System Diagnostics${RESET}"
echo -e "${BOLD}════════════════════════════════════════════════════════════════════${RESET}"
echo ""

# 1. Battery status
echo -e "${GREEN}▶ Battery & Power Source (TLP)${RESET}"
if command -v tlp-stat >/dev/null 2>&1; then
    sudo tlp-stat -b 2>/dev/null | grep -E "Power source|Battery|Charge|Energy|Status|health" | sed "s/^/   /" || true
else
    echo "   TLP not installed or not in PATH."
fi
echo ""

# 2. CPU & Platform profile
echo -e "${GREEN}▶ CPU Energy & Governor (TLP)${RESET}"
if command -v tlp-stat >/dev/null 2>&1; then
    sudo tlp-stat -p 2>/dev/null | grep -E "governor|scaling_governor|energy_perf|EPP|platform_profile" | head -n 12 | sed "s/^/   /" || true
fi
echo ""

# 3. PowerTOP wakeups & top consumers
echo -e "${GREEN}▶ Top Wakeups & Consumers (PowerTOP 3s sample)${RESET}"
TMP_CSV=$(mktemp)
sudo powertop --csv="$TMP_CSV" --time=3 >/dev/null 2>&1 || true
if [[ -f "$TMP_CSV" ]]; then
    awk -F";" '
    /Top 10 Power Consumers/ { flag=1; count=0; next }
    flag && NF > 1 {
        if ($1 ~ /Power est/ || $1 ~ /Usage/) next;
        gsub(/^[ \t]+|[ \t]+$/, "", $1);
        gsub(/^[ \t]+|[ \t]+$/, "", $2);
        if ($1 != "" && count < 6) {
            printf "   %-18s %s\n", $1, $2;
            count++;
        }
    }
    flag && NF <= 1 && count > 0 { flag=0 }
    ' "$TMP_CSV" || true
    rm -f "$TMP_CSV"
fi
echo ""
echo -e "${DIM}Options: ryoku-power-report --live (interactive) | --html (generate full HTML report)${RESET}"
echo -e "${BOLD}════════════════════════════════════════════════════════════════════${RESET}"
